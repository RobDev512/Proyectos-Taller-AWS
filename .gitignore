# ============================================================
# Proyectos Taller AWS - .gitignore
# ============================================================

# --- Windows / macOS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Archivos temporales ---
*.tmp
*.temp
*.bak
*.old
*.swp
*.swo
*~

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Respaldos y archivos comprimidos ---
*.zip
*.rar
*.7z

# --- Variables de entorno / secretos ---
.env
.env.*
!.env.example

# --- Node.js / JavaScript ---
node_modules/
dist/
build/
.cache/
coverage/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/

# --- Java ---
*.class
target/
.gradle/

# --- AWS / Serverless ---
.aws-sam/
.serverless/
cdk.out/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*

# --- IDEs ---
.idea/

# VS Code / Kiro settings locales
.vscode/

# IMPORTANTE:
# No ignoramos .kiro porque queremos conservar
# los Specs del workshop dentro del repositorio.
